# ─────────────────────────────────────────────────────────────
# GeoTrade — Environment Configuration
# Copy this file to .env and fill in your values
# ─────────────────────────────────────────────────────────────

# ── MongoDB ───────────────────────────────────────────────────
# Local:  mongodb://localhost:27017
# Atlas:  mongodb+srv://<user>:<password>@cluster.mongodb.net
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=geotrade

# ── News Sources ──────────────────────────────────────────────
# Optional: get a free key at https://newsapi.org
# If blank, ingestion falls back to RSS feeds + bundled samples
NEWS_API_KEY=

# ── Pipeline Tuning ───────────────────────────────────────────
INGESTION_DAYS_BACK=30
MAX_ARTICLES_PER_RUN=500
NLP_BATCH_SIZE=8

# ── Tension Score Formula ─────────────────────────────────────
# score = ALPHA * neg_sentiment + BETA * conflict_gravity + GAMMA * coverage_signal
# conflict_gravity: Goldstein-scale-inspired continuous event weight (CAMEO literature)
# coverage_signal:  log-normalised article count (Caldara-Iacoviello / BBVA approach)
TENSION_ALPHA=0.50
TENSION_BETA=0.35
TENSION_GAMMA=0.15

# ── Backend API ───────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000

# ── Frontend ──────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
